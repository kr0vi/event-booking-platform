// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  orders    Order[]
  ticket    Ticket[]

  @@map("users")
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  location      String
  date          String
  time          String
  posterImage   String
  galleryImages String[]
  highlights    Json[]
  thingsToKnow  String[] @default([])

  totalTickets Int
  ticketsSold  Int @default(0)

  price  Int
  status eventStatus @default(OPEN)

  organizerId Int
  organizer   User @relation(fields: [organizerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  ticket    Ticket[]

  @@map("events")
}
enum eventStatus {
  SOON
  OPEN
  CLOSED
}

model Order {
  id            String        @id @default(uuid())
  userId        Int
  eventId       String
  quantity      Int
  totalAmount   Int
  paymentStatus paymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id])
  event  Event    @relation(fields: [eventId], references: [id])
  ticket Ticket[]

  @@map("orders")
}

enum paymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Ticket {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  qrToken String @unique
  qrImage String

  status ticketStatus

  usedAt DateTime?

  @@map("tickets")
}

enum ticketStatus {
  USED
  VALID
}
